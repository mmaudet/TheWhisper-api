# TheWhisper-api CUDA Configuration (Hybrid)
# For Docker deployment on Linux with NVIDIA GPU

# ============================================================================
# Backend Selection
# ============================================================================
# Options: auto, thestage, faster-whisper
# - auto: Auto-detect (prefers TheStageAI if available, falls back to faster-whisper)
# - thestage: Use TheStageAI SDK (requires Dockerfile.thestage)
# - faster-whisper: Use faster-whisper with OpenAI models (standard Dockerfile)
BACKEND_TYPE=auto

# ============================================================================
# Model Configuration
# ============================================================================

# For TheStageAI backend:
# MODEL_NAME=TheStageAI/thewhisper-large-v3-turbo  (default)
# MODEL_NAME=TheStageAI/thewhisper-large-v3

# For faster-whisper backend (OpenAI models):
# Available models: tiny, base, small, medium, large-v2, large-v3, large-v3-turbo
MODEL_NAME=large-v3-turbo

# Leave empty to use backend defaults
# MODEL_NAME=

# ============================================================================
# Device Configuration
# ============================================================================
# Options: cuda, cpu (use cuda for GPU acceleration)
DEVICE=cuda

# ============================================================================
# Compute Type (faster-whisper only)
# ============================================================================
# Options for CUDA: float16, int8_float16, int8
# float16 = good balance of speed and accuracy (default)
# int8_float16 or int8 = faster but slightly less accurate
# Ignored when using TheStageAI backend
COMPUTE_TYPE=float16

# ============================================================================
# Chunk Configuration (TheStageAI only)
# ============================================================================
# Chunk length in seconds for processing
# TheStageAI models support: 10s, 15s, 20s, 30s
# Ignored when using faster-whisper backend
CHUNK_LENGTH_S=10

# ============================================================================
# Server Configuration
# ============================================================================
PORT=8000

# Model Cache Directory
# Models will be downloaded here on first run and cached
MODEL_CACHE_DIR=/models

# ============================================================================
# GPU Configuration (Optional)
# ============================================================================
# Specific GPU device (if you have multiple GPUs)
# Uncomment to use specific GPU:
# CUDA_VISIBLE_DEVICES=0
