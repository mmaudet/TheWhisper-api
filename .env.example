# Twake Whisper Backend Configuration

# Whisper Model Configuration
# Available models: mlx-community/whisper-base, whisper-small, whisper-medium, whisper-large-v3, whisper-large-v3-turbo
MODEL_NAME=mlx-community/whisper-large-v3-turbo

# Server Configuration
PORT=8000

# Audio Processing
# Chunk duration in seconds (default: 15)
# Longer chunks = more context but slower response
# CHUNK_DURATION=15
